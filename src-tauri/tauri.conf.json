{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AuthKeeper",
  "version": "1.2.1",
  "identifier": "com.authkeeper.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "AuthKeeper - by MUKHAMAD IRFAN",
        "width": 420,
        "height": 700,
        "minWidth": 380,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": true,
      "endpoints": [
        "https://raw.githubusercontent.com/Mukhamadirfan1997/AuthKeeper/main/update.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNFNTVGNDVGMzE1OTg4RTcKUldUbmlGa3hYL1JWUGpnNnRneVl3bFRLV0dhTzlhK296QUVpL01rSndGVFpwUDZyeW5Qa3JsUGkK"
    }
  }
}
